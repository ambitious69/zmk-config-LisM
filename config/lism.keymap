#define ZMK_POINTING_DEFAULT_SCRL_VAL 200

#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    tapping-term-ms = <300>;
    flavor = "balanced";
};

&lt { quick-tap-ms = <300>; };

/ {
    macros {
        emoji: emoji_macro {
            compatible = "zmk,behavior-macro";
            label = "EMOJI";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp CAPSLOCK>,
                <&macro_tap>,
                <&kp E>,
                <&macro_release>,
                <&kp CAPSLOCK>;
        };
    };

    behaviors {
        encoder_msc: sensor_rotate_msc {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
        };

        encoder_kp: sensor_rotate_kp {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Default Layer";
            bindings = <
&lt 3 Q         &kp W                               &kp E           &kp R           &kp T                                          &kp Y           &kp U           &kp I                    &kp O                &lt 1 P
&kp A           &kp S                               &kp D           &kp F           &kp G                                          &kp H           &kp J           &kp K                    &kp L                &lt 2 MINUS
&kp Z           &kp X                               &kp C           &kp V           &kp B                                          &kp N           &kp M           &kp COMMA                &kp DOT              &mt LEFT_SHIFT RIGHT_BRACE
&mt LCTRL LBKT  &mt LEFT_SHIFT LS(INTERNATIONAL_1)  &kp GRAVE       &msc SCRL_UP    &lt 5 SPACE      &lt 1 TAB    &lt 5 BACKSPACE  &lt 6 ENTER     &msc SCRL_UP    &mt RIGHT_ALT RC(LANG1)  &mt RIGHT_GUI GRAVE  &mt LEFT_CONTROL BACKSLASH
                                                    &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_RIGHT                                &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_RIGHT
            >;

            sensor-bindings = <&encoder_msc SCRL_UP SCRL_DOWN>;
        };

        layer_1 {
            display-name = "Mouse Layer";
            bindings = <
&kp ESCAPE  &none      &kp LG(PRINTSCREEN)  &kp LG(G)  &kp LC(LS(K))                    &kp DELETE  &kp LC(LS(TAB))  &kp LC(TAB)     &kp TAB          &none
&kp LC(A)   &kp LC(S)  &none                &kp LC(F)  &kp LC(H)                        &mkp MB4    &mkp MB1         &kp UP_ARROW    &mkp MB2         &none
&kp LC(Z)   &kp LC(X)  &kp LC(C)            &kp LC(V)  &none                            &mkp MB5    &kp LEFT_ARROW   &kp DOWN_ARROW  &kp RIGHT_ARROW  &none
&trans      &trans     &trans               &trans     &trans         &trans    &trans  &trans      &trans           &trans          &trans           &trans
                       &trans               &trans     &trans                           &trans      &trans           &trans
            >;

            sensor-bindings = <&inc_dec_kp LS(LC(TAB)) LC(TAB)>;
        };

        layer_2 {
            display-name = "Number Layer";
            bindings = <
&kp ESCAPE  &none      &kp LG(PRINTSCREEN)  &kp LG(G)  &kp LC(LS(K))                    &kp DEL   &kp LC(LS(TAB))  &kp LC(TAB)  &kp TAB          &none
&kp LC(A)   &kp LC(S)  &none                &kp LC(F)  &kp LC(LCTRL)                    &mkp MB4  &mkp MB1         &kp UP       &mkp MB2         &none
&kp LC(Z)   &kp LC(X)  &kp LC(C)            &kp LC(V)  &none                            &mkp MB5  &kp LEFT_ARROW   &kp DOWN     &kp RIGHT_ARROW  &none
&trans      &trans     &trans               &kp UP     &trans         &trans    &trans  &trans    &kp UP           &trans       &trans           &trans
                       &kp LEFT             &kp DOWN   &kp RIGHT                        &kp LEFT  &kp DOWN         &kp RIGHT
            >;

            sensor-bindings = <&encoder_kp C_VOL_UP C_VOL_DN>;
        };

        layer_3 {
            display-name = "Mark Layer";
            bindings = <
&none   &kp C_BRIGHTNESS_INC  &kp C_VOL_UP  &kp LANGUAGE_1  &kp RS(LANGUAGE_2)                    &kp F7        &kp F8        &kp F9        &kp F10       &kp F11
&none   &kp C_BRIGHTNESS_DEC  &kp C_VOL_DN  &none           &none                                 &none         &none         &none         &none         &kp F12
&none   &none                 &none         &none           &none                                 &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans                &trans        &trans          &trans              &trans    &trans  &trans        &trans        &none         &bt BT_CLR    &bt BT_CLR_ALL
                              &trans        &trans          &trans                                &trans        &trans        &trans
            >;

            sensor-bindings = <&inc_dec_kp 0 0>;
        };

        layer_4 {
            display-name = "Device Layer";
            bindings = <
&none        &none           &none   &none   &bt BT_CLR                           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&none        &none           &none   &none   &none                                &none         &none         &none         &none         &none
&sys_reset   &none           &none   &none   &none                                &none         &none         &none         &none         &sys_reset
&bootloader  &bt BT_CLR_ALL  &none   &none   &none       &none    &studio_unlock  &none         &none         &none         &none         &bootloader
                             &trans  &trans  &trans                               &trans        &trans        &trans
            >;
        };

        layer_5 {
            display-name = "Number Layer";
            bindings = <
&kp LS(NUMBER_1)    &kp LS(SLASH)        &kp LS(NUMBER_3)  &kp COLON         &none                               &kp PERIOD    &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9        &kp MINUS
&kp SLASH           &kp LS(N5)           &kp LS(NUMBER_6)  &none             &none                               &kp COMMA     &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6        &kp SLASH
&kp LS(LEFT_BRACE)  &kp LS(NUMBER_7)     &kp LS(NUMBER_2)  &kp LS(NUMBER_8)  &kp LS(NUMBER_9)                    &kp NUMBER_0  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3        &kp APOS
&trans              &kp INTERNATIONAL_1  &kp LS(EQUAL)     &trans            &trans            &trans    &trans  &kp F10       &trans        &kp COLON     &kp LS(UNDERSCORE)  &kp KP_PLUS
                                         &trans            &trans            &trans                              &trans        &trans        &trans
            >;

            sensor-bindings = <&inc_dec_kp LS(LC(TAB)) LC(TAB)>;
        };

        layer_6 {
            status = "reserved";
            display-name = "LEFT_device";
            bindings = <
&none         &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &none                     &none      &none      &kp LG(PRINTSCREEN)  &kp LG(G)  &kp LS(LC(K))
&none         &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &none                     &kp LC(A)  &kp LC(S)  &none                &kp LC(F)  &kp LC(H)
&kp NUMBER_0  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &none                     &kp LC(Z)  &kp LC(X)  &kp LC(C)            &kp LC(V)  &none
&trans        &trans        &trans        &trans        &trans  &trans    &trans  &trans     &trans     &trans               &trans     &trans
                            &trans        &trans        &trans                    &trans     &trans     &trans
            >;
        };
    };
};
